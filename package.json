{
  "name": "spaci",
  "productName": "Spaci",
  "version": "2.2.1-rc.1",
  "description": "Spaci: a complete dev + Mac cleaner. Reclaim disk space from build artifacts (node_modules, target, .next…) and developer/system caches, with previews, recommendations and a polished UI. Built by kentom.co.ke.",
  "main": "src/main.js",
  "author": "kentom.co.ke",
  "homepage": "https://spaci.kentom.co.ke",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "bench": "node scripts/bench-scan.mjs",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ke.co.kentom.spaci",
    "productName": "Spaci",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://spaci.kentom.co.ke/updates",
        "channel": "latest"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/branding/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "YAD95QLFD7"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/branding/icon.ico",
      "artifactName": "Spaci-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/branding/icon.png",
      "executableName": "spaci",
      "synopsis": "Reclaim disk space from build artifacts and developer caches",
      "maintainer": "Raccoon254 <Raccoon254@users.noreply.github.com>"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    }
  }
}
